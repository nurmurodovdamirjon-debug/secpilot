APP_ENV=development
APP_NAME=SecPilot Defense
APP_VERSION=0.1.0

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

BOT_TOKEN=change-me
BOT_ADMIN_IDS=123456789
ALLOWED_TARGETS=example.com,api.example.com
POLICY_FAIL_CLOSED=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=secpilot
POSTGRES_USER=secpilot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://secpilot:change-me@postgres:5432/secpilot

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

QUEUE_BACKEND=celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LOG_LEVEL=INFO
STRUCTURED_LOGS=true
METRICS_ENABLED=true

CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=

VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=

AUTO_BLOCK_ENABLED=false
AUTO_BLOCK_MAX_ACTIONS_PER_10M=10
DEFAULT_TEMP_BLOCK_SECONDS=3600

HONEYPOT_ENABLED=true
CANARY_BASE_URL=https://token.example.uz

PDF_REPORT_ENABLED=true
REPORT_TZ=Asia/Tashkent
