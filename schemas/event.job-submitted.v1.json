{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job.submitted.v1",
  "type": "object",
  "required": [
    "type",
    "id",
    "time",
    "data"
  ],
  "properties": {
    "type": {
      "const": "job.submitted.v1"
    },
    "id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "job_id",
        "job_type",
        "asset_id"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "job_type": {
          "type": "string"
        },
        "asset_id": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        }
      }
    }
  }
}
